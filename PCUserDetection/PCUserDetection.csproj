<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PCUserDetection</RootNamespace>
    <AssemblyName>PCUserDetection</AssemblyName>
    <!-- Keeps the output at bin\<Config>\ (no TFM sub-folder), which is a
         shorter path to reach and to point a shortcut at. AppPaths finds the
         project folder by looking for this file, so the depth is its own choice
         rather than something the runtime paths depend on. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- AForge 2.2.5 only ships .NET Framework binaries; they run fine on
         .NET 8 on Windows, so the compatibility warning is not actionable. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <!-- Targets .NET 8, but runs on any newer major runtime that is installed. -->
    <RollForward>LatestMajor</RollForward>
    <!-- The icon the shell shows for the file: in Explorer, on a shortcut, and
         on the taskbar before the window is up. What the window itself wears is
         set separately; see AppIcon. -->
    <ApplicationIcon>Assets\PCUserDetection.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <Product>PCUserDetection</Product>
    <Copyright>Copyright © 2025-2026 Jc Calayag</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- ApplicationIcon above hands the icon to the shell, which is not
         somewhere the running app can read it back from at every size it
         needs. Embedding the same file lets the window load it as a stream, so
         the title bar and the taskbar each pick the size drawn for them
         instead of a stretched copy of one. -->
    <EmbeddedResource Include="Assets\PCUserDetection.ico"
                      LogicalName="PCUserDetection.Assets.PCUserDetection.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The services are internal, since nothing outside this assembly builds
         against them. The test project is the one exception: it exercises them
         directly, and making them public to allow that would advertise an API
         the app does not have. -->
    <InternalsVisibleTo Include="PCUserDetection.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AForge.Video.DirectShow" Version="2.2.5" />
    <PackageReference Include="FaceAiSharp.Bundle" Version="0.5.23" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
