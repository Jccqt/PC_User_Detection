# Secrets / local environment
.env

# Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Ll]og/
[Ll]ogs/

# Visual Studio / Rider / VS Code working folders
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# NuGet
# packages/ is the legacy packages.config restore folder; PackageReference
# restores to the global cache instead, so nothing here belongs in the repo.
packages/
*.nupkg
*.snupkg
!**/[Pp]ackages/build/

# Build results / caches
*.cache
*.tmp
project.lock.json
project.assets.json
msbuild.log
msbuild.err
msbuild.wrn

# Test / coverage
[Tt]est[Rr]esult*/
*.coverage
*.coveragexml

# OS cruft
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Email alert settings. These live in %APPDATA%\PCUserDetection and are never
# meant to be in the repository; this only catches a copy left in the tree.
email.json
SentMail/

# Registered user photos and the most recent captured frame. These are images
# of a real person's face and belong to whoever runs the app, not to the
# repository. AppPaths creates both folders on demand, so a clone works without
# them.
PCUserDetection/AnonymousImages/
PCUserDetection/CapturedImages/
